<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/noteListFragment">

    <fragment
        android:id="@+id/noteListFragment"
        android:name="com.example.offlinenotes.ui.fragments.NoteListFragment"
        android:label="Offline Notes"
        tools:layout="@layout/fragment_note_list">
        <action
            android:id="@+id/action_noteListFragment_to_noteEditorFragment"
            app:destination="@id/noteEditorFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    
    <fragment
        android:id="@+id/noteEditorFragment"
        android:name="com.example.offlinenotes.ui.fragments.NoteEditorFragment"
        android:label="Edit Note"
        tools:layout="@layout/fragment_note_editor">
        <argument
            android:name="note"
            app:argType="com.example.offlinenotes.model.Note"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
</navigation>
c. Menu XMLFor toolbar actions like Search and Delete.